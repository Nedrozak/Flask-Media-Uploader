# Required: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
FLASK_SECRET_KEY=replace-with-a-random-secret
# Redis is required. For local Docker development:
# docker compose -f docker-compose.dev.yml up -d
REDIS_URL=redis://localhost:6379/0
UPLOAD_FOLDER=./uploads

# Upload limits
CHUNK_SIZE=5242880
MAX_FILE_SIZE=1073741824
MAX_REQUEST_SIZE=7340032
MAX_FILES_PER_SESSION=20
MAX_SESSION_BYTES=2147483648
SESSION_EXPIRY_SECONDS=1800
TOKEN_EXPIRY_SECONDS=21600
CLEANUP_EXPIRY_GRACE_SECONDS=60
# Preserve this many bytes of free filesystem space. Set to 0 only in constrained test/dev environments.
# For Internet-facing production on a dedicated data volume, 10 GiB is a safer floor.
MIN_FREE_DISK_BYTES=10737418240
WTF_CSRF_TIME_LIMIT_SECONDS=43200

# Browser uploads
UPLOAD_CONCURRENCY=3
UPLOAD_REQUEST_TIMEOUT_MS=180000
CHUNK_UPLOAD_RETRIES=2
TRANSFER_FINALIZE_TIMEOUT_SECONDS=900

# Production HTTPS/proxy settings. Leave proxy counts at 0 when running directly.
SESSION_COOKIE_SECURE=false
HSTS_MAX_AGE=0
TRUSTED_HOSTS=
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=0
PROXY_FIX_X_HOST=0

# Structured application audit events. Bearer tokens are fingerprinted, never logged raw.
AUDIT_ENABLED=true
AUDIT_LOG_STATIC=false
AUDIT_LOG_HEALTH=false
# Keep JSON audit events out of the interactive server terminal by default.
AUDIT_LOG_CONSOLE=false
AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_RETENTION_DAYS=14
# Signed first-party visitor correlation stored in the Flask session cookie.
VISITOR_RETENTION_DAYS=30

# Authenticated administration panel at /admin.
# Generate the hash with: media-uploader-admin-hash
# The Redis share registry defaults to the value of ADMIN_ENABLED when
# SHARE_REGISTRY_ENABLED is unset. Set it explicitly only if you want
# registry collection while the panel itself is disabled.
ADMIN_ENABLED=false
# SHARE_REGISTRY_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=3600
# Share registry/history retention after each link expires.
ADMIN_SHARE_HISTORY_DAYS=365
RATE_LIMIT_ADMIN_LOGIN=10

# Docker/Traefik production values
# Persistent bind-mounted state. On OCI, mount the dedicated data volume here.
MEDIA_UPLOADER_DATA_DIR=/srv/media-uploader
UPLOAD_HOST=uploads.example.com
ACME_EMAIL=admin@example.com
