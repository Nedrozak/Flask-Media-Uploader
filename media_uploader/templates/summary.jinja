{% extends "base.jinja" %}
{% block title %}Upload Summary{% endblock %}

{% block content %}
  <a href="{{ url_for('main.index') }}" class="btn btn-sm btn-outline-light back-link position-absolute top-0 start-0 m-3">
    Back to home
  </a>
  <h1 class="h2 mb-4 text-center">Uploaded Files</h1>

  <div class="mb-3">
    <label for="shareableLink" class="form-label">Shareable link</label>
    <div class="input-group">
      <input
        type="text"
        id="shareableLink"
        class="form-control"
        value="{{ url_for('shares.summary', token=token, _external=True) }}"
        readonly
      />
      <button class="btn btn-outline-light" type="button" id="copyBtn">Copy</button>
    </div>
    <small id="expiryInfo" class="expiry-info" data-ttl="{{ ttl }}">
      Anyone with this URL can access these files until the share expires.
      <span id="timeLeft"></span>
    </small>
  </div>

  <ul id="fileList" class="list-group mt-2" aria-live="polite"></ul>
  <script id="uploadedFilesData" type="application/json">{{ files | tojson }}</script>
{% endblock %}

{% block scripts %}
  <script src="{{ url_for('static', filename='scripts/summary.js') }}" defer></script>
{% endblock %}
